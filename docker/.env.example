# 单二进制部署变量模板：复制为 docker/.env 后填写。
# docker compose 会自动读取同目录的 .env，并把同一份文件注入应用容器。
#
# 启动时逐项校验：TRIPFOLIO_ENV=prod 要求签名密钥与高德 Web 服务 key 齐备，站点地址 http／https 都可以；
# 邮件和对象存储可不配置，相关功能返回 503。

# ---------- 运行模式 ----------
# prod：严格校验（邮件不得用 log、高德 Web 服务 key 必填），站点地址 http／https 都可以。
#       这套编排不带 TLS：直接用 http 访问即可，刷新 Cookie 的 Secure 会跟随协议自动关闭，
#       启动只打印一条告警（分享链接是 http、Cookie 不以 Secure 传输，适合内网或个人自用）。
# dev ：宽松模式（邮件可用 log、签名密钥缺失只告警），适合本地或内网试跑，不要用于对外服务。
TRIPFOLIO_ENV=prod

# ---------- 站点 ----------
# 对外访问地址（服务端用它拼分享链接 <地址>/s/<token>，并决定刷新 Cookie 是否带 Secure）
# **这一行不能删**：删掉会退回默认 http://localhost:5173，分享出去的链接会指向 localhost。
# http／https 都行：写成 http 就按无 TLS 运行（Secure 自动关闭，启动告警提醒代价）。
# 非默认端口要写全，例如 https://trip.example.com:61118、http://192.168.1.10:61118
TRIPFOLIO_WEB_BASE_URL=https://trip.example.com
# 允许的请求来源：网页域 + Capacitor 应用来源（安卓包固定 https://localhost）。
# **来源必须与浏览器发出的 Origin 完全一致**：协议＋主机＋端口，非默认端口不能省。
# 站点在 61118 端口却只写 https://trip.example.com，获取验证码等写接口会返回
# 403 CSRF_FAILED「请求来源不被允许」。两个变量里的站点地址应保持一致。
TRIPFOLIO_CORS_ORIGINS=https://trip.example.com,https://localhost
# 宿主机映射端口（容器内固定 :8080）
TRIPFOLIO_HTTP_PORT=8080
# 刷新 Cookie 的 Secure 与 __Host- 前缀跟随站点协议自动决定：https 开启、http 关闭，
# 因此**不需要配置**。只有特殊场景才显式覆盖：已有 HTTPS 代理但地址暂时写成 http 时设 true；
# 站点是 https 但想在 http 下限时自测可设 false。与协议冲突时启动日志会提醒登录会失效。
# TRIPFOLIO_COOKIE_SECURE=true

# ---------- 已有 PostgreSQL（本编排不部署数据库）----------
# 数据库在宿主机：主机名写 host.docker.internal；在另一台机器：写内网域名或 IP。
# 库需要提前建好，账号要有建表权限（启动时会自动迁移）。
TRIPFOLIO_DATABASE_URL=postgres://tripfolio:密码@host.docker.internal:5432/tripfolio?sslmode=disable
# 等待数据库可达的上限与重试间隔；外部库启动较慢时可以调大
TRIPFOLIO_STARTUP_DB_TIMEOUT=60s
TRIPFOLIO_STARTUP_DB_RETRY_INTERVAL=2s
# 容器启动时是否自动迁移（默认 true）。多副本或想先手工迁移时设为 false，
# 此时启动会核对结构版本，落后就拒绝启动而不是带着旧结构运行。
TRIPFOLIO_AUTO_MIGRATE=true
TRIPFOLIO_DB_MAX_CONNS=10

# ---------- 签名与派生密钥 ----------
# 用来签发访问令牌、给分页游标与验证码算摘要。格式 kid=base64（解码后至少 32 字节）。
# 部署包里的 install.sh 会在留空时自动生成一次并写入本文件，**留空即可**，不必手工配。
# 手工部署时自行生成：openssl rand -base64 32，然后写成 TRIPFOLIO_KEYRING=k1=<输出>
# （注意是两个等号：变量名=kid=base64；漏掉 k1= 会让 base64 末尾的填充 = 被误当分隔符）
# 轮换时写成 "k2=<新>,k1=<旧>"：第一项用于签发，其余只验签。
# 只生成一次并长期保存：换了它会让所有已登录会话、分页游标与未使用的验证码失效（数据不受影响）。
TRIPFOLIO_KEYRING=k1=

# ---------- 邮件（可选，注册与找回密码验证码）----------
# prod 中 DRIVER 留空时默认 disabled，也可显式设为 disabled；未启用时验证码接口返回 503，已有账号仍可登录。
# 启用时改为 smtp 并填写下面的配置；prod 不允许会把验证码写入日志的 log 驱动。
# 旧 .env 若写了 MAIL_DRIVER=smtp 而暂不需要发信，请改为 disabled。
TRIPFOLIO_MAIL_DRIVER=disabled
TRIPFOLIO_MAIL_SMTP_HOST=smtpdm.aliyun.com
TRIPFOLIO_MAIL_SMTP_PORT=465
TRIPFOLIO_MAIL_SMTP_IMPLICIT_TLS=true
TRIPFOLIO_MAIL_SMTP_USERNAME=
TRIPFOLIO_MAIL_SMTP_PASSWORD=
TRIPFOLIO_MAIL_FROM=no-reply@example.com
TRIPFOLIO_MAIL_FROM_NAME=Tripfolio

# ---------- 阿里云 OSS（可选）----------
# 未配齐 ENDPOINT、BUCKET、ACCESS_KEY_ID、SECRET_ACCESS_KEY 时不启用存储，文件授权接口返回 503，不阻塞启动。
# OSS 用虚拟主机寻址，USE_PATH_STYLE 必须为 false。
# 桶需在控制台配置 CORS：允许 PUT/GET/HEAD、暴露 ETag（前端用 ETag 校验直传完整性）、
# 允许来源填网页域。前端是直传，端点必须是浏览器能访问的公网地址。
# 端点示例：https://oss-cn-hangzhou.aliyuncs.com
TRIPFOLIO_OBJECTSTORE_ENDPOINT=
TRIPFOLIO_OBJECTSTORE_REGION=cn-hangzhou
TRIPFOLIO_OBJECTSTORE_BUCKET=
TRIPFOLIO_OBJECTSTORE_ACCESS_KEY_ID=
TRIPFOLIO_OBJECTSTORE_SECRET_ACCESS_KEY=
TRIPFOLIO_OBJECTSTORE_USE_PATH_STYLE=false

# ---------- 高德地图（两套凭证，别混用）----------
# 后端 Web 服务 Key：POI 搜索、逆地理编码、算路（prod 必填）
TRIPFOLIO_AMAP_WEB_SERVICE_KEY=
# JS API 安全密钥：由应用进程内的 /_AMapService 代理覆盖进请求，不下发到浏览器
TRIPFOLIO_AMAP_JSCODE=
# JS API Key：编译期注入前端产物，**改了要重新 docker compose build**；缺失时页面可用但没有底图
VITE_AMAP_JS_KEY=

# ---------- 可调项 ----------
TRIPFOLIO_LOG_LEVEL=info
TRIPFOLIO_SHUTDOWN_TIMEOUT=15s
TRIPFOLIO_WORKER_MAX_JOBS=20
# 高德调用限制：每账号每分钟上限，以及单进程全局日上限（0 表示不限，重启会重置）
TRIPFOLIO_GEO_PER_ACCOUNT_PER_MINUTE=60
TRIPFOLIO_GEO_GLOBAL_DAILY_LIMIT=0
TRIPFOLIO_GEO_CACHE_TTL=24h
TRIPFOLIO_GEO_TIMEOUT=5s

# ---------- 镜像与构建 ----------
# 镜像标签，便于回滚到上一个版本
TRIPFOLIO_IMAGE_TAG=latest
# 大陆构建加速
TRIPFOLIO_BUILD_NPM_REGISTRY=https://registry.npmmirror.com
TRIPFOLIO_BUILD_GOPROXY=https://goproxy.cn,direct
