{
  "name": "tripfolio",
  "private": true,
  "version": "0.1.0",
  "description": "Tripfolio 单仓库：Go 后端、Vue 3 前端（网页 + Capacitor 安卓）、OpenAPI 契约",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "contracts:build": "pnpm --filter @tripfolio/contracts build",
    "client:dev": "pnpm --filter @tripfolio/client dev",
    "client:build": "pnpm --filter @tripfolio/client build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @tripfolio/contracts build && pnpm --filter @tripfolio/client build",
    "format": "prettier --write \"**/*.{ts,vue,json,yaml,yml,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,yaml,yml,md,css}\""
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
