# 复制为 scripts/.deploy.env 后填写（该文件已被 .gitignore 忽略，不要提交）。
# 供 scripts/docker-deploy-nas.sh 使用：构建 → 导出 → scp → NAS 上 docker load → compose up。

# NAS 的地址与 SSH 端口（需要免密：把公钥放到 NAS 的 ~/.ssh/authorized_keys）
NAS_HOST=192.168.1.10
NAS_PORT=22
NAS_USER=admin

# NAS 上的部署目录：compose 与 .env 放这里，例如群晖的 /volume1/docker/tripfolio
NAS_DIR=/volume1/docker/tripfolio

# 容器管理器的项目名；留空则取 NAS_DIR 的目录名
#NAS_PROJECT=tripfolio

# NAS 上的 docker 可执行文件与提权方式：
# 群晖 DSM 7 一般是 /usr/local/bin/docker 且需要 sudo；若以 root 登录可把 SUDO 设为空
#NAS_DOCKER=/usr/local/bin/docker
#SUDO=sudo

# 构建平台：x86_64 的 NAS 用 linux/amd64；arm64 的 NAS 用 linux/arm64
# （arm64 构建需要能拉取对应架构的基础镜像）
#PLATFORM=linux/amd64

# 镜像名与临时上传目录
#IMAGE=tripfolio/app
#NAS_TMP=/tmp
