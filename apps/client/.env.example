# 生产网页与 Capacitor 打包时复制为 .env.production。
# 网页同源部署可写 /api/v1；Capacitor 应用来源是 https://localhost，必须写 API 的绝对地址。
VITE_API_BASE_URL=https://api.example.com/api/v1

# 高德 JS API Key（浏览器公开标识），与后端 Web 服务 Key 分开申请。
VITE_AMAP_JS_KEY=
# 网页同源部署可不填；Capacitor 必须指向可访问的 HTTPS 代理。
VITE_AMAP_SERVICE_HOST=
# 仅供 Vite 开发代理读取，禁止改成 VITE_ 前缀。生产在 Caddy 环境中配置同名变量。
AMAP_JSCODE=
