    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@lucide/vue": "1.46.0",
    "@vue/devtools-api": "^8.1.5",
    "echarts": "^6.1.0",
    "element-plus": "2.14.5",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.3",
    "vant": "4.10.2",
    "vue": "3.5.42",
    "vue-draggable-plus": "0.6.1",
    "vue-echarts": "^8.3.0",
    "vue-router": "5.3.1"
