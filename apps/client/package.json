{
  "name": "@tripfolio/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tripfolio 前端：一个 Vue 3 工程同时产出网页（桌面壳 + 移动壳）与 Capacitor 安卓应用",
  "scripts": {
    "dev": "vite",
