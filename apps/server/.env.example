# 复制为 .env 后，api、worker、migrate 在开发环境启动时会自动读取（TRIPFOLIO_ENV=prod 时不读，生产配置由部署平台注入）；
# 也可以直接 export，已存在的环境变量优先于文件。所有变量以 TRIPFOLIO_ 为前缀，含义见 internal/config/config.go。
TRIPFOLIO_ENV=dev
TRIPFOLIO_HTTP_ADDR=:8080
TRIPFOLIO_DATABASE_URL=postgres://tripfolio:tripfolio@localhost:5432/tripfolio?sslmode=disable
TRIPFOLIO_DB_MAX_CONNS=10
TRIPFOLIO_LOG_LEVEL=info
TRIPFOLIO_SHUTDOWN_TIMEOUT=15s
# 网页开发服务器与 Capacitor 应用来源
TRIPFOLIO_CORS_ORIGINS=http://localhost:5173,https://localhost
TRIPFOLIO_WORKER_MAX_JOBS=20
# 集成测试专用库；测试会重建其 public schema，不要指向业务库
TRIPFOLIO_TEST_DATABASE_URL=postgres://tripfolio:tripfolio@localhost:5432/tripfolio_test?sslmode=disable

# 私有对象存储（S3 兼容）。开发用 MinIO：
#   docker compose -f infra/compose.yaml up -d minio
#   docker compose -f infra/compose.yaml run --rm minio-init   # 建桶与暂存前缀清理规则
# 控制台 http://localhost:9001（tripfolio / tripfolio-dev-secret）。
# 生产改为阿里云 OSS：端点形如 https://oss-cn-hangzhou.aliyuncs.com，USE_PATH_STYLE=false。
# 开发环境不配也能启动，文件相关接口会返回 503 DEPENDENCY_UNAVAILABLE；生产必填。
TRIPFOLIO_OBJECTSTORE_ENDPOINT=http://localhost:9000
TRIPFOLIO_OBJECTSTORE_REGION=us-east-1
TRIPFOLIO_OBJECTSTORE_BUCKET=tripfolio
TRIPFOLIO_OBJECTSTORE_ACCESS_KEY_ID=tripfolio
TRIPFOLIO_OBJECTSTORE_SECRET_ACCESS_KEY=tripfolio-dev-secret
# MinIO 必须用路径寻址；OSS 与 AWS 用虚拟主机寻址。缺省时非生产为 true、生产为 false
TRIPFOLIO_OBJECTSTORE_USE_PATH_STYLE=true
# 注意：浏览器直传需要的桶 CORS 不在这里配。MinIO 不实现按桶 CORS（PutBucketCors 返回
# NotImplemented），开发环境改 infra/compose.yaml 里 minio 服务的 MINIO_API_CORS_ALLOW_ORIGIN；
# 生产 OSS 在控制台按桶配置，需允许 PUT/GET/HEAD 并暴露 ETag（前端用 ETag 确认上传完整性）。
# 对象存储集成测试端点；未设置时 tests/integration 的对象存储用例跳过
TRIPFOLIO_TEST_OBJECTSTORE_ENDPOINT=http://localhost:9000

# 高德 Web 服务 API key，只在服务端使用，经 /geo 代理接口对客户端开放。
# 与前端 JS API key 是两套凭证：JS API 的安全密钥由 Caddy 在 /_AMapService 追加，见 infra/caddy/Caddyfile。
# 开发环境不配也能启动，地点接口会返回 503；生产必填。
TRIPFOLIO_AMAP_WEB_SERVICE_KEY=
# 每账号每分钟上限
TRIPFOLIO_GEO_PER_ACCOUNT_PER_MINUTE=60
# 全局日上限，0 表示不限制；用于保护高德免费配额（搜索类每月 5000 次）
TRIPFOLIO_GEO_GLOBAL_DAILY_LIMIT=0
# 逆地理编码结果按坐标（约 100 米）缓存时长
TRIPFOLIO_GEO_CACHE_TTL=24h
TRIPFOLIO_GEO_TIMEOUT=5s
